{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "scopebeacon",
  "main": "apps/api/src/worker.ts",
  "compatibility_date": "2026-11-26",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "scopebeacon-production",
      "database_id": "b04935ec-abb5-4360-8318-66c6bc3eae4a",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "17 3 * * *"
    ]
  },
  "workers_dev": true,
  "preview_urls": false
}
