{
  "name": "scopebeacon",
  "version": "0.1.0",
  "private": true,
  "description": "A full-stack project delivery workspace with shareable client progress pages.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch apps/api/src/server.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -p apps/api/tsconfig.json && vite build",
    "build:web": "vite build",
    "build:demo": "vite build --mode demo",
    "start": "tsx apps/api/src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc -p apps/api/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "dotenv": "^18.0.10",
    "hono": "^4.13.22",
    "lucide-react": "^0.577.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.2.1",
    "jsdom": "^27.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
